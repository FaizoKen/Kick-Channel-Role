# PostgreSQL password — used by the `db` service in compose.yml AND
# interpolated into DATABASE_URL. Set both halves consistently in prod.
# Generate a fresh value: `openssl rand -base64 24`
POSTGRES_PASSWORD=

# DATABASE_URL templates `${POSTGRES_PASSWORD}` for compose; if you run the
# app outside compose, replace the placeholder with the literal password.
DATABASE_URL=postgres://kcr:${POSTGRES_PASSWORD}@db:5432/kick_channel_role

# Long random HMAC key used to sign session + iframe-session tokens AND
# (Phase 3) to derive the KEK that encrypts broadcaster OAuth tokens at rest.
# Generate a fresh value per environment: `openssl rand -base64 48`
SESSION_SECRET=

# Public-facing base URL of this plugin (no trailing slash). Origin must be HTTPS in prod.
BASE_URL=https://your-domain.com/kick-channel-role

LISTEN_ADDR=0.0.0.0:8094

# Auth Gateway integration (required — sync workers call /auth/internal/*).
# Defaults to deriving the origin from BASE_URL if unset. Set explicitly in local dev.
# AUTH_GATEWAY_URL=http://localhost:8090

# Shared secret — must match the Auth Gateway's INTERNAL_API_KEY value.
# Generate: `openssl rand -hex 32`
INTERNAL_API_KEY=

# Base URL of the RoleLogic API. Default: https://api-rolelogic.faizo.net.
# Override per environment (staging, DR region, local replay). No trailing slash.
# ROLELOGIC_API_URL=https://api-rolelogic.faizo.net

# Origin allowed to embed this plugin's role-config page in an iframe (the
# dashboard's origin). Defaults to https://rolelogic.faizo.net when unset.
# RL_DASHBOARD_ORIGIN=https://rolelogic.faizo.net

# --- Kick OAuth & webhook credentials (Phase 3+) -------------------------
# Register your app at https://kick.com/settings/developer to obtain these.
# The redirect URI you register MUST be `{BASE_URL}/oauth/kick/broadcaster/callback`
# (and the viewer variant for member verification).
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=

# No webhook secret: Kick signs webhook deliveries with its own RSA key pair.
# The app fetches the public key from GET /public/v1/public-key at runtime.

# --- Follow probe --------------------------------------------------------
# Kick's PUBLIC API cannot answer "does user X follow channel Y" — there is no
# follower list, no per-user relationship endpoint, and no follow flag on any
# webhook payload. The only official signal is `channel.followed`, which fires
# ONLY on a fresh follow. That means anyone who already followed before they
# linked their Kick account is invisible to us and never gets their role — the
# only workaround being to unfollow and re-follow.
#
# The follow probe closes that gap by reading Kick's undocumented channel
# user-card endpoint (kick.com/api/v2/channels/{slug}/users/{username}) during
# verification. It is strictly additive: webhooks stay authoritative, and if
# the endpoint is unavailable or changes shape the probe goes quiet and the
# verify page falls back to guiding the member through a re-follow.
#
# Set to false to disable it and run on documented signals only.
# KICK_FOLLOW_PROBE_ENABLED=true

# Origin the probe calls. Point at a stub for tests/staging.
# KICK_PROBE_BASE_URL=https://kick.com

# Probe requests per minute, per replica. Deliberately conservative.
# KICK_PROBE_RPM=20

# How many separately-spaced "not following" answers must agree before a
# stored follow is removed. Kick sends no unfollow event, so probes are the
# only way to ever clear a stale follow — but a single bad read must never
# cost a member their role. Misses are also rate-limited to one per 6h, so the
# default of 3 puts at least ~12h of consistent negatives before a removal.
# Raise to be more cautious; values below 1 are clamped to 1.
# KICK_UNFOLLOW_CONFIRMATIONS=3

# --- Scaling knobs -------------------------------------------------------

# Number of job-polling worker tasks (Phase 7). Each claims a batch via
# `FOR UPDATE SKIP LOCKED` so this scales linearly until DB-pool saturation.
# WORKER_CONCURRENCY=4

# DB pool sizing. Budget (replicas * DB_MAX_CONNECTIONS) ≤ pgBouncer pool.
# DB_MAX_CONNECTIONS=16
# DB_MIN_CONNECTIONS=2
# DB_ACQUIRE_TIMEOUT_SECS=5
# DB_IDLE_TIMEOUT_SECS=600

# Default keeps app logs at INFO and `tower_http` at WARN.
RUST_LOG=kick_channel_role=info,tower_http=warn
